{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["sway/workspaces"],
    "modules-right": ["sway/language", "network", "pulseaudio", "backlight", "battery", "clock", "custom/power"],
    "sway/workspaces": {
        "format": "{name}",
        "all-outputs": false,
        "disable-scroll": true,
        "on-click": "activate"
    },
    "sway/language": {
        "format": "⌨ {short}"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " wired",
        "format-disconnected": " offline",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": ["", "", ""],
        "on-click": "pavucontrol"
    },
"backlight": {
    "format": "☀ {percent}%",
    "scroll-step": 5
},
"custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "bash /home/haiku/.config/sway/powermenu.sh"
},
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    }
}
